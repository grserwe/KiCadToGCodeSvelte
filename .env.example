# Outbound mail for the feedback form. Leave unset in development: reports are
# then logged to the dev server console instead of sent.
#
# Resend (recommended): SMTP_HOST=smtp.resend.com, SMTP_USER=resend,
# SMTP_PASS=<API key>, EMAIL_FROM on a domain verified in Resend.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=feedback@kicadtogcode.com

# Where feedback reports are delivered. Defaults to KiCadToGCode@outlook.com.
FEEDBACK_TO=
